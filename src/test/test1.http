  "caloriesPerUnit": 1200,
  "ingredients": ["flour", "water", "salt", "sourdough starter"],
  "allergens": ["gluten"],
  "tags": ["artisan", "organic", "freshly-baked"],
  "initialStock": 20,
  "minimumStock": 5,
  "reorderLevel": 8
}

