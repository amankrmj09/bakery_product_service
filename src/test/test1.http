### Test 3: Product Operations

# Test 3a: Create Sourdough Bread
POST http://localhost:8083/api/products
Content-Type: application/json

# Expected Response:
# {
#   "id": "...",
#   "sku": "BREAD001",
#   ...other fields...
# }

{
  "sku": "BREAD001",
  "name": "Artisan Sourdough Bread",
  "description": "Traditional sourdough bread made with wild yeast starter",
  "shortDescription": "Fresh artisan sourdough",
  "categoryId": "88282c1f-3d9d-4dee-9617-d39bc51cd0b1",
  "price": 8.99,
  "status": "ACTIVE",
  "isFeatured": true,
  "preparationTimeMinutes": 30,
  "shelfLifeHours": 48,
  "unit": "loaf",
