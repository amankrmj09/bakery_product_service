@baseUrl = http://bakery-api.blubug.me
@adminEmail = admin@bakery.com
@adminPassword = Admin@123

### 1. Admin Login (Auth Service to get Bearer Token)
# @name loginAdmin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "usernameOrEmail": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

> {%
    client.test("Admin Login successful", function () {
        client.assert(response.status === 200, "Response status is not 200");
        client.assert(response.body.hasOwnProperty("access_token"), "No access token found");
    });
    client.global.set("auth_token", response.body.access_token);
%}

### 2. Main Service Health Check (Type: Public)[cite: 5]
# @name healthCheck
GET {{baseUrl}}/api/health
Accept: application/json

> {%
    client.test("Health check returns UP", function () {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

### 3. Service Info (Type: Public)[cite: 5]
# @name serviceInfo
GET {{baseUrl}}/api/info
Accept: application/json

---
## CREATE CATEGORIES (10 Items)[cite: 5]
---

### Create Category 1: Breads (Type: Admin)[cite: 5]
# @name createCat1
POST {{baseUrl}}/api/categories
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "name": "Artisan Breads",
  "description": "Freshly baked daily breads",
  "displayOrder": 1,
  "active": true,
  "mediaUrls": [],
  "iconClass": "icon-bread"
}

> {%
    client.global.set("cat1_id", response.body.id);
%}

